#!/bin/bash

set -euo pipefail

PROJECT_DIR="/var/www/cartada-viva"
BACKEND_DIR="$PROJECT_DIR/backend"
FRONTEND_DIR="$PROJECT_DIR/frontend"

REPO_URL="git@github.com:guedes-jr/Django-NextJS-UltimaCartada.git"
BRANCH="main"

BACKEND_SERVICE="cartada-viva-backend"
FRONTEND_SERVICE="cartada-viva-frontend"

SERVER_IP="IP_DA_VPS"
DJANGO_SETTINGS_MODULE_VALUE="config.settings"

BACKEND_HEALTH_URL="http://127.0.0.1:8000/django-admin/"
FRONTEND_HEALTH_URL="http://127.0.0.1:3000/login"
PUBLIC_FRONTEND_URL="http://${SERVER_IP}/login"
PUBLIC_ADMIN_URL="http://${SERVER_IP}/admin/dashboard"
PUBLIC_DJANGO_ADMIN_URL="http://${SERVER_IP}/django-admin/"

log() {
  echo "[DEPLOY] $1"
}

fail() {
  echo "[ERRO] $1"
  exit 1
}

echo "=========================================="
echo "[DEPLOY] Atualizando Cartada Viva"
echo "=========================================="

if [ ! -d "$PROJECT_DIR" ]; then
  fail "Diretório do projeto não encontrado: $PROJECT_DIR"
fi

cd "$PROJECT_DIR"

log "Verificando repositório Git..."

if [ ! -d ".git" ]; then
  echo "Clone o projeto primeiro:"
  echo "git clone $REPO_URL $PROJECT_DIR"
  fail "Este diretório não é um repositório Git."
fi

CURRENT_REMOTE=$(git remote get-url origin || true)

if [ "$CURRENT_REMOTE" != "$REPO_URL" ]; then
  log "Ajustando remote origin..."
  git remote set-url origin "$REPO_URL"
fi

log "Testando acesso SSH ao GitHub..."
if ! ssh -T git@github.com 2>&1 | grep -Eq "successfully authenticated|You've successfully authenticated|Hi "; then
  echo ""
  echo "A VPS não tem acesso SSH ao GitHub."
  echo ""
  echo "Gere uma chave SSH com:"
  echo "ssh-keygen -t ed25519 -C \"deploy-cartada-viva\""
  echo ""
  echo "Depois copie a chave pública:"
  echo "cat ~/.ssh/id_ed25519.pub"
  echo ""
  echo "E adicione em:"
  echo "GitHub > Repositório > Settings > Deploy keys > Add deploy key"
  fail "Acesso SSH ao GitHub não configurado."
fi

log "Salvando commit atual para possível rollback..."
PREVIOUS_COMMIT=$(git rev-parse HEAD)
echo "$PREVIOUS_COMMIT" > "$PROJECT_DIR/.last_deploy_commit"

log "Buscando atualizações do GitHub..."
git fetch origin "$BRANCH"

log "Atualizando código para origin/$BRANCH..."
git reset --hard "origin/$BRANCH"

log "Limpando arquivos não rastreados com segurança..."
git clean -fd \
  -e backend/.env \
  -e backend/.venv \
  -e backend/media \
  -e backend/staticfiles \
  -e frontend/.env.production \
  -e frontend/.env.local \
  -e frontend/node_modules \
  -e frontend/.next

echo "=========================================="
log "Validando backend"
echo "=========================================="

if [ ! -d "$BACKEND_DIR" ]; then
  fail "Diretório backend não encontrado: $BACKEND_DIR"
fi

if [ ! -f "$BACKEND_DIR/.env" ]; then
  fail "Arquivo backend/.env não encontrado."
fi

cd "$BACKEND_DIR"

if [ ! -d ".venv" ]; then
  log "Criando ambiente virtual Python..."
  python3 -m venv .venv
fi

log "Ativando ambiente virtual..."
source .venv/bin/activate

log "Atualizando pip..."
python -m pip install --upgrade pip

log "Instalando dependências do backend..."
if [ -f "requirements/prod.txt" ]; then
  pip install -r requirements/prod.txt
elif [ -f "requirements.txt" ]; then
  pip install -r requirements.txt
else
  fail "Nenhum arquivo de requirements encontrado."
fi

log "Garantindo Gunicorn instalado..."
pip install gunicorn

log "Checando configuração Django..."
DJANGO_SETTINGS_MODULE="$DJANGO_SETTINGS_MODULE_VALUE" python manage.py check

log "Aplicando migrations..."
DJANGO_SETTINGS_MODULE="$DJANGO_SETTINGS_MODULE_VALUE" python manage.py migrate --noinput

log "Coletando arquivos estáticos..."
DJANGO_SETTINGS_MODULE="$DJANGO_SETTINGS_MODULE_VALUE" python manage.py collectstatic --noinput

echo "=========================================="
log "Validando frontend"
echo "=========================================="

if [ ! -d "$FRONTEND_DIR" ]; then
  fail "Diretório frontend não encontrado: $FRONTEND_DIR"
fi

cd "$FRONTEND_DIR"

if [ -f ".env.local" ]; then
  log "frontend/.env.local encontrado; renomeando para backup."
  mv .env.local ".env.local.bak.$(date +%Y%m%d_%H%M%S)"
fi

if [ ! -f ".env.production" ]; then
  echo "Crie o arquivo com:"
  echo "NEXT_PUBLIC_API_URL=/api/v1"
  fail "Arquivo frontend/.env.production não encontrado."
fi

if ! grep -q "NEXT_PUBLIC_API_URL=/api/v1" ".env.production"; then
  echo "[AVISO] Recomendo usar no frontend/.env.production:"
  echo "NEXT_PUBLIC_API_URL=/api/v1"
fi

log "Instalando dependências do frontend..."
if [ -f "package-lock.json" ]; then
  npm ci
else
  npm install
fi

log "Gerando build do Next.js..."
npm run build

echo "=========================================="
log "Reiniciando serviços"
echo "=========================================="

sudo systemctl daemon-reload

log "Reiniciando backend: $BACKEND_SERVICE"
sudo systemctl restart "$BACKEND_SERVICE"

log "Reiniciando frontend: $FRONTEND_SERVICE"
sudo systemctl restart "$FRONTEND_SERVICE"

log "Testando configuração do Nginx..."
sudo nginx -t

log "Recarregando Nginx..."
sudo systemctl reload nginx

log "Aguardando serviços subirem..."
sleep 6

echo "=========================================="
log "Verificando status dos serviços"
echo "=========================================="

if ! sudo systemctl is-active --quiet "$BACKEND_SERVICE"; then
  sudo systemctl status "$BACKEND_SERVICE" --no-pager
  fail "Backend não subiu corretamente."
fi

if ! sudo systemctl is-active --quiet "$FRONTEND_SERVICE"; then
  sudo systemctl status "$FRONTEND_SERVICE" --no-pager
  fail "Frontend não subiu corretamente."
fi

if ! sudo systemctl is-active --quiet nginx; then
  sudo systemctl status nginx --no-pager
  fail "Nginx não está ativo."
fi

echo "=========================================="
log "Testes locais"
echo "=========================================="

if ! curl -fsI "$BACKEND_HEALTH_URL" > /dev/null; then
  echo "[INFO] Se você ainda não moveu o Django Admin para /django-admin/, ajuste BACKEND_HEALTH_URL no script."
  fail "Backend não respondeu em $BACKEND_HEALTH_URL"
fi

if ! curl -fsI "$FRONTEND_HEALTH_URL" > /dev/null; then
  fail "Frontend não respondeu em $FRONTEND_HEALTH_URL"
fi

echo "=========================================="
log "Testes públicos via Nginx"
echo "=========================================="

if [ "$SERVER_IP" != "IP_DA_VPS" ]; then
  if ! curl -fsI "$PUBLIC_FRONTEND_URL" > /dev/null; then
    fail "Frontend público não respondeu em $PUBLIC_FRONTEND_URL"
  fi
else
  echo "[AVISO] SERVER_IP ainda está como IP_DA_VPS. Ajuste o script para testar URL pública."
fi

echo "=========================================="
echo "[DEPLOY] Atualização concluída com sucesso!"
echo "=========================================="
echo ""
echo "Commit anterior salvo em:"
echo "$PROJECT_DIR/.last_deploy_commit"
echo ""
echo "Landing:"
echo "http://${SERVER_IP}/"
echo ""
echo "Login:"
echo "$PUBLIC_FRONTEND_URL"
echo ""
echo "Painel Admin Next:"
echo "$PUBLIC_ADMIN_URL"
echo ""
echo "Django Admin:"
echo "$PUBLIC_DJANGO_ADMIN_URL"
echo ""
echo "Logs úteis:"
echo "sudo journalctl -u $BACKEND_SERVICE -f"
echo "sudo journalctl -u $FRONTEND_SERVICE -f"
echo "sudo tail -f /var/log/nginx/error.log"
