NEXT_PUBLIC_API_URL=/api/v1

# Opcional: endereço HTTPS de inscrição confirmado pela consultora. Sem ele, a página orienta solicitar o link por WhatsApp.
NEXT_PUBLIC_HERBALIFE_REGISTRATION_URL=

# Link HTTPS oficial da oferta Método Última Cartada / mentoria. Requer novo build.
# Sem link válido, os convites direcionam ao WhatsApp.
NEXT_PUBLIC_HOTMART_CHECKOUT_URL=

# Prévia da consultoria: disponível em desenvolvimento; em build de homologação, habilitar explicitamente.
# Manter false na produção pública até aprovação. Alterar exige novo build.
ENABLE_CONSULTORIA_PREVIEW=false

# WhatsApp confirmado da marca (somente dígitos com código do país); vazio não ativa contato externo na prévia.
CONSULTORIA_WHATSAPP_NUMBER=

# Nova apresentação nas URLs definitivas. Ativar somente em build de homologação ou publicação aprovada.
# false preserva todas as páginas atuais; mudar exige novo build. Não habilita a prévia /preview.
ENABLE_CONSULTORIA_SITE=false

# Canal comercial Herbalife confirmado, independente do contato da mentoria. Vazio não ativa links.
CONSULTORIA_HERBALIFE_WHATSAPP_NUMBER=

# Fatos confirmados da oferta: texto literal aprovado, sem segredos. Vazio mostra "A confirmar".
# Lidos no servidor durante o build: qualquer alteração exige rebuild/revisão.
CONSULTORIA_MENTORSHIP_DURATION=
CONSULTORIA_GAME_DURATION=
CONSULTORIA_FORMAT=
CONSULTORIA_MEETINGS=
CONSULTORIA_MATERIALS=

# Identificação profissional completa aprovada pela titular (texto simples; não HTML).
CONSULTORIA_PROFESSIONAL_IDENTITY=
# Somente usuário oficial do Instagram, com ou sem @; não inserir URL.
CONSULTORIA_INSTAGRAM_USERNAME=

# Encaminhamento local opt-in de /api/v1 para Django em 127.0.0.1:8000.
# Só tem efeito em development; produção mantém Nginx e ignora esta opção.
# Preferir npm run dev:consultoria para aplicar também a URL relativa da API sem editar .env real.
CONSULTORIA_LOCAL_API_PROXY=false
